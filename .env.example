# Where the log files live inside the container (mounted read-only).
LOG_DIR=/logs
# Host directory that docker compose mounts at LOG_DIR.
LOG_HOST_DIR=./data/logs

# SQLite database location.
DB_PATH=/app/data/weblog.sqlite

# Optional: history endpoint of a dyndns-updater instance, used to learn your
# own networks so their traffic can be excluded. Leave empty to disable.
HISTORY_URL=
# Optional static self networks (comma separated), e.g. 192.0.2.0
SELF_NETWORKS=

# Web server bind address and port.
HOST=0.0.0.0
PORT=8095

# Additional vhost aliases as comma-separated from=to pairs, applied after the
# built-in defaults (www. stripping).
# Example: VHOST_ALIASES=shop.example.org=example.org
VHOST_ALIASES=

# Optional: SFTP access to the web host's log directory, used by
# scripts/fetch-logs.sh. Leave empty when the logs are placed by other means.
SFTP_HOST=
SFTP_USER=
SFTP_PASS=
# Download target of scripts/fetch-logs.sh (its default is ./data/logs).
FETCH_LOG_DIR=
# Remote log directory on the SFTP host (default /logs).
REMOTE_DIR=
