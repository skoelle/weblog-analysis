# Where log files are read from. The container-side SFTP fetch writes here too.
LOG_DIR=/app/data/logs

# SQLite database location.
DB_PATH=/app/data/weblog.sqlite

# Optional: history endpoint of a dyndns-updater instance, used to learn your
# own networks so their traffic can be excluded. Leave empty to disable.
HISTORY_URL=
# Optional static self networks (comma separated), e.g. 192.0.2.0
SELF_NETWORKS=

# Web server bind address and port.
HOST=0.0.0.0
PORT=8095

# Container timezone. Also the clock FETCH_SCHEDULE uses, which matters because
# log rotation happens at local midnight.
TZ=Europe/Berlin

# Additional vhost aliases as comma-separated from=to pairs, applied after the
# built-in defaults (www. stripping).
# Example: VHOST_ALIASES=shop.example.org=example.org
VHOST_ALIASES=

# Optional SFTP source. Without these the fetch is skipped and LOG_DIR must be
# filled by other means (bind mount, docker cp, a mounted share, ...).
SFTP_HOST=
SFTP_PORT=22
SFTP_USER=
SFTP_PASS=
# Host key verification is mandatory. Either pin the fingerprint ...
# Get it with: ssh-keyscan -t ed25519 HOST | ssh-keygen -lf -
SFTP_HOST_KEY=
# ... or point at a known_hosts file.
SFTP_KNOWN_HOSTS=
SFTP_REMOTE_DIR=/logs

# Automatic fetch inside the container. Logs usually rotate shortly after
# midnight, so 01:30 leaves a safe buffer. Comma separated HH:MM list in local
# time; leave empty to disable. FETCH_ON_STARTUP runs one fetch at boot.
FETCH_SCHEDULE=01:30
FETCH_ON_STARTUP=false

# Raw log files in LOG_DIR are deleted once their newest log line is older than
# this many days. Database rows are never removed. 0 disables the cleanup.
FILE_RETENTION_DAYS=400

# Build-time deployment, configured as GitHub repository secrets rather than
# here: WEBHOOK_URL and WEBHOOK_TOKEN trigger Watchtower after a :latest build.
